---
// Import CSS Global Anda
import "../assets/styles/global.css";

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta property="og:site_name" content="Borneox Travel Samarinda" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Borneox Travel Samarinda",
        "url": "https://borneox.biz.id/"
      }
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL(image, Astro.site || "https://borneox.biz.id")}
    />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="Borneox Travel" />

    <!-- Astro akan otomatis bundle dan optimize CSS -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <main>
      <slot />
    </main>

    <div id="imageModal" class="modal">
      <span class="close-modal">&times;</span>
      <img class="modal-content" id="imgFull" />
      <div id="caption"></div>
    </div>

    <script>
      // toggle image preview logic
      document.addEventListener("click", function (e) {
        const modal = document.getElementById("imageModal");
        const modalImg = document.getElementById(
          "imgFull",
        ) as HTMLImageElement | null;
        const captionText = document.getElementById("caption");

        const target = e.target as HTMLElement | null;
        if (target && target.tagName === "IMG") {
          const imgTarget = target as HTMLImageElement;
          if (
            imgTarget.closest(".logo") ||
            imgTarget.closest(".whatsapp-float") ||
            imgTarget.classList.contains("no-preview")
          )
            return;
          e.preventDefault();
          if (modal && modalImg && captionText) {
            modal.style.display = "flex";
            modal.style.flexDirection = "column";
            modalImg.src = imgTarget.src;
            captionText.innerHTML = imgTarget.alt || "Preview Gambar";
          }
        }
      });

      const closeModal = document.querySelector(
        ".close-modal",
      ) as HTMLElement | null;
      if (closeModal) {
        closeModal.onclick = function () {
          const modal = document.getElementById("imageModal");
          if (modal) {
            modal.style.display = "none";
          }
        };
      }

      // Animasi Button Pesan Sekarang floater animation logic
      document.addEventListener("DOMContentLoaded", () => {
        const notifBtn = document.getElementById("notifButton");
        if (!notifBtn) return;
        setTimeout(() => {
          notifBtn.classList.add("show-ball");
          setTimeout(startLeftRollAnimation, 1500);
        }, 3000);

        function startLeftRollAnimation() {
          if (!notifBtn) return;
          notifBtn.classList.add("expand");
          setTimeout(() => {
            if (!notifBtn) return;
            notifBtn.classList.remove("expand");
            setTimeout(startLeftRollAnimation, 3600);
          }, 6000);
        }
      });
    </script>
  </body>
</html>
