---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatButton from "../components/FloatButton.astro";
import ImageModal from "../components/ImageModal.astro";
import BottomNavigation from "../components/BottomNavigation.astro";

import RouteItem from "../components/RouteItem.astro";
---

<Layout title="Borneox - Travel Samarinda Kalimantan">
  <Header />

  <!-- poster section -->
  <section class="hero" id="home">
    <picture>
      <source
        media="(max-width: 768px)"
        srcset="/asset/mobile/poster_mobile.png"
        class="poster-mobile"
      />
      <img
        src="/asset/poster.png"
        alt="Borneox Layanan Travel Samarinda Kalimantan"
        class="hero-image"
      />
    </picture>
    <div class="hero-overlay">
      <div class="container">
        <h1>Perjalanan Nyaman, Lintas Kalimantan Tanpa Hambatan.</h1>
        <p>Layanan Travel Profesional & Terpercaya</p>
        <a
          href="https://wa.me/6282195768386?text=Halo%20Borneox%20Travel%2C%20saya%20ingin%20tanya%20ketersediaan%20jadwal%20keberangkatan%20untuk%20perjalanan%20dalam%20waktu%20dekat.%20Bisa%20dibantu%3F"
          class="btn-pesan"
          target="_blank">PESAN SEKARANG</a
        >
      </div>
    </div>
  </section>

  <section class="seo-section">
    <div class="container">
      <h2>Travel Terpercaya Antar Kota di Kalimantan</h2>
      <p>
        Borneox Travel adalah layanan transportasi antar kota terpercaya yang
        melayani rute-rute utama di Kalimantan seperti Banjarmasin, Samarinda,
        Balikpapan, Pontianak, dan Palangkaraya. Dengan armada yang terawat dan
        driver berpengalaman, kami siap mengantarkan Anda dengan nyaman dan aman
        ke tujuan.
      </p>
      <p>
        Nikmati perjalanan lintas kota dengan harga terjangkau, armada bersih,
        dan pelayanan 24/7. Pesan sekarang untuk mendapatkan harga terbaik!
      </p>
    </div>
  </section>

  <!-- Armada section -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Pilihan Armada</h2>
      <div class="mobil-container">
        <div class="mobil-card">
          <img
            src="asset/daihatsu_hitam.webp"
            alt="Pilihan Armada Mobil Daihatsu Sigra Hitam"
            width="840"
          />
          <h3>Sigra Standard</h3>
          <p>Aman & Nyaman</p>
          <a
            href="https://wa.me/6282195768386?text=Halo%20Borneox%20Travel%2C%20saya%20tertarik%20memesan%20layanan%20dengan%20unit%20mobil%20yang%20ada%20di%20website.%20Sigra%20Berwarna%20Hitam."
            class="btn-pilih"
            target="_blank">Pesan</a
          >
        </div>
        <div class="mobil-card">
          <img
            src="asset/daihatsu_coklat.webp"
            alt="Pilihan Armada Mobil Daihatsu Sigra Coklat"
            width="840"
          />
          <h3>Sigra Executive</h3>
          <p>Peningkatan & Fasilitas</p>
          <a
            href="https://wa.me/6282195768386?text=Halo%20Borneox%20Travel%2C%20saya%20tertarik%20memesan%20layanan%20dengan%20unit%20mobil%20yang%20ada%20di%20website.%20Sigra%20Berwarna%20Coklat."
            class="btn-pilih"
            target="_blank">Pesan</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- rute section -->
  <section class="section bg-light" id="rute">
    <picture>
      <source
        media="(max-width: 768px)"
        srcset="asset/mobile/rute_poster_mobile.png"
        class="rute-mobile"
      />
      <img
        src="asset/rute_poster.png"
        alt="Rute Perjalanan Borneox Travel Samarinda Kalimantan"
        class="banner-image"
        width="1440"
        height="300"
      />
    </picture>
    <div class="container">
      <h2 class="section-title">Rute Perjalanan</h2>
      <p class="subtitle">
        Melayani Rute Antar Kota & Provinsi setiap hari. Lorem ipsum, dolor sit
        amet consectetur adipisicing elit. Earum blanditiis veritatis iste, nemo
        laudantium iure odio animi assumenda natus officiis molestiae suscipit
        harum magni ipsam rem saepe quibusdam commodi! Aut!
      </p>
      <div class="rute-list">
        <section class="rute-region">
          <h2>Rute Kalimantan Timur</h2>
          <RouteItem
            asal="Samarinda"
            tujuan1="Balikpapan"
            tujuan2="Tenggarong"
            tujuan3="Bontang"
            wilayah="Kalimantan Timur"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Sangatta"
            tujuan2="Berau"
            tujuan3="Melak"
            wilayah="Kalimantan Timur"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Penajam Paser Utara"
            tujuan2="Nusantara"
            tujuan3="Tanah Grogot"
            wilayah="Kalimantan Timur"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Tabang"
            tujuan2="Muarawahau"
            tujuan3="Tandjungredeb"
            wilayah="Kalimantan Timur"
          />
        </section>

        <section class="rute-region">
          <h2>Rute Kalimantan Barat</h2>
          <RouteItem
            asal="Samarinda"
            tujuan1="Pontianak"
            tujuan2="Sambas"
            tujuan3="Bengkayang"
            wilayah="Kalimantan Barat"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Landak"
            tujuan2="Mempawah"
            tujuan3="Sanggau"
            wilayah="Kalimantan Barat"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Ketapang"
            tujuan2="Sintang"
            tujuan3="Kapuas Hulu"
            wilayah="Kalimantan Barat"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Sekadau"
            tujuan2="Melawi"
            tujuan3="Kayong Utara"
            wilayah="Kalimantan Barat"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Kubu Raya"
            tujuan2="Singkawang"
            tujuan3="Karangan"
            wilayah="Kalimantan Barat"
          />
        </section>

        <section class="rute-region">
          <h2>Rute Kalimantan Tengah</h2>
          <RouteItem
            asal="Samarinda"
            tujuan1="Kotawaringin Barat"
            tujuan2="Kotawaringin Timur"
            tujuan3="Kapuas"
            wilayah="Kalimantan Tengah"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Barito Selatan"
            tujuan2="Barito Utara"
            tujuan3="Sukamara"
            wilayah="Kalimantan Tengah"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Lamandau"
            tujuan2="Seruyan"
            tujuan3="Katingan"
            wilayah="Kalimantan Tengah"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Pulang Pisau"
            tujuan2="Gunung Mas"
            tujuan3="Barito Timur"
            wilayah="Kalimantan Tengah"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Murung Raya"
            tujuan2="Palangka Raya"
            tujuan3="Bukit Sawit"
            wilayah="Kalimantan Tengah"
          />
        </section>

        <section class="rute-region">
          <h2>Rute Kalimantan Selatan</h2>
          <RouteItem
            asal="Samarinda"
            tujuan1="Tanah Laut"
            tujuan2="Baru"
            tujuan3="Banjar"
            wilayah="Kalimantan Selatan"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Barito Kuala"
            tujuan2="Tapin"
            tujuan3="Hulu Sungai Selatan"
            wilayah="Kalimantan Selatan"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Amuntai"
            tujuan2="Kandangan"
            tujuan3="Tabalong"
            wilayah="Kalimantan Selatan"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Tanah Bumbu"
            tujuan2="Balangan"
            tujuan3="Banjarmasin"
            wilayah="Kalimantan Selatan"
          />
          <RouteItem
            asal="Samarinda"
            tujuan1="Banjar Baru"
            tujuan2="Sebamban"
            tujuan3="Satui"
            wilayah="Kalimantan Selatan"
          />
        </section>
      </div>
    </div>
  </section>

  <!-- gallery section-->
  <section class="section" id="gallery">
    <picture>
      <source
        media="(max-width: 768px)"
        srcset="asset/mobile/galeri_poster_mobile.png"
      />
      <img
        src="asset/galeri_poster.png"
        alt="Galeri Perjalanan Borneox Travel Samarinda Kalimantan"
        class="banner-image"
        width="1440"
        height="300"
      />
    </picture>
    <div class="container">
      <h2 class="section-title">Galeri Borneox</h2>
      <p class="subtitle">Dokumentasi Perjalanan Driver & Penumpang Kami.</p>
      <div class="galeri-grid">
        <div class="galeri-item">
          <img
            src="#"
            alt="perjalanan samarinda balikpapan"
            loading="lazy"
            class="img-galeri"
          />
        </div>
        <div class="galeri-item"></div>
        <div class="galeri-item"></div>
        <div class="galeri-item"></div>
      </div>
    </div>
  </section>
  <Footer />
  <BottomNavigation />
  <FloatButton />
  <ImageModal />
</Layout>
